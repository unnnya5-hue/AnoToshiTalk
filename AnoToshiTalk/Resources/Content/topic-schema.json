{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anotoshitalk/topics.schema.json",
  "title": "AnoToshiTalk bundled topics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "generatedAt", "topics"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "shortDescription",
        "conversationPrompt",
        "year",
        "category",
        "genderAffinity",
        "sourceName",
        "sourceURL",
        "linkCheckedAt",
        "tags",
        "isActive",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "conversationPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "year": {
          "type": "integer",
          "minimum": 1960,
          "maximum": 2100
        },
        "startYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "endYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "category": {
          "enum": [
            "music",
            "screen",
            "gamesToys",
            "lifestyle",
            "sports",
            "news",
            "schoolCulture"
          ]
        },
        "genderAffinity": {
          "enum": ["all", "maleLeaning", "femaleLeaning"]
        },
        "ageAffinity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0, "maximum": 100 },
            "max": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "imageAsset": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "linkCheckedAt": {
          "type": "string",
          "format": "date"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 30 }
        },
        "isActive": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

